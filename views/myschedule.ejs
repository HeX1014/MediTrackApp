<!DOCTYPE html>
<html>
<head>
    <title>My Schedule</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-5">
    <h1>My Schedule</h1>
    <p>A personalised view of your upcoming appointments and current medications, <strong><%= user.username %></strong>.</p>
    <hr>

    <% if (messages && messages.length > 0) { %>
        <div class="alert alert-success">
            <% messages.forEach(function(message) { %>
                <p class="mb-0"><%= message %></p>
            <% }); %>
        </div>
    <% } %>

    <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger">
            <% errors.forEach(function(error) { %>
                <p class="mb-0"><%= error %></p>
            <% }); %>
        </div>
    <% } %>

    <h4>Upcoming Appointments</h4>
    <% if (appointments.length === 0) { %>
        <div class="alert alert-info">You currently have no appointments.</div>
    <% } else { %>
        <table class="table table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>Hospital / Clinic</th>
                    <th>Preferred Doctor</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Reason / Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% for (let i = 0; i < appointments.length; i++) { %>
                    <tr>
                        <td><%= appointments[i].clinicHospital %></td>
                        <td><%= appointments[i].preferredDoctor %></td>
                        <td><%= appointments[i].appointmentDate %></td>
                        <td><%= appointments[i].appointmentTime %></td>
                        <td><%= appointments[i].additionalNotes %></td>
                        <td>
                            <a href="/editAppointment/<%= appointments[i].appointmentId %>" class="btn btn-warning">Edit</a>
                            <form
                                action="/appointments/<%= appointments[i].appointmentId %>/delete"
                                method="POST"
                                class="d-inline"
                                onsubmit="return confirm('Are you sure you want to delete this appointment? This cannot be undone.');"
                            >
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    <% } %>

    <h4 class="mt-4">My Medications</h4>
    <% if (medications.length === 0) { %>
        <div class="alert alert-info">You currently have no medications on file.</div>
    <% } else { %>
        <table class="table table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>Medication</th>
                    <th>Dosage</th>
                    <th>Frequency</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% for (let i = 0; i < medications.length; i++) { %>
                    <tr>
                        <td><%= medications[i].medicationName %></td>
                        <td><%= medications[i].dosage %></td>
                        <td><%= medications[i].frequency %></td>
                        <td><%= medications[i].startDate %></td>
                        <td>
                            <% if (medications[i].endDate) { %>
                                <%= medications[i].endDate %>
                            <% } else { %>
                                Ongoing
                            <% } %>
                        </td>
                        <td><%= medications[i].notes %></td>
                        <td>
                            <a href="/patient/editMedication/<%= medications[i].medicationId %>" class="btn btn-warning">Edit</a>
                            <form
                                action="/medications/<%= medications[i].medicationId %>/delete"
                                method="POST"
                                class="d-inline"
                                onsubmit="return confirm('Are you sure you want to delete this medication? This cannot be undone.');"
                            >
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    <% } %>

    <a href="/dashboard" class="btn btn-secondary mt-3">Back to Dashboard</a>
</div>
</body>
</html>