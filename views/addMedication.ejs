<!DOCTYPE html>
<html>

<head>
    <title>Add Medication</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <div class="container mt-5">

        <h2>Add Medication to Tracker</h2>

        <hr>

        <form action="/addMedication" method="POST">
            <div class="mb-3">

                <label class="form-label">
                    Medication Name *
                </label>
                <input type="text" name="medicationName" class="form-control" placeholder="Enter medication name"
                    required>
            </div>

            <div class="mb-3">

                <label class="form-label">
                    Dosage *
                </label>
                <input type="text" name="dosage" class="form-control" placeholder="Enter dosage (e.g., 500mg)" required>
            </div>

            <div class="mb-3">

                <label class="form-label">
                    Frequency *
                </label>
                <input type="text" name="frequency" class="form-control"
                    placeholder="Enter frequency (e.g., 2 times a day)" required>
            </div>

            <div class="mb-3">

                <label class="form-label">
                    Start Date *
                </label>
                <input type="date" name="startDate" class="form-control" required>
            </div>

            <div class="mb-3">

                <label class="form-label">
                    End Date 
                </label>
                <input type="date" name="endDate" class="form-control">
            </div>

            <button type="submit" class="btn btn-primary">
                Add Medication
            </button>

            <a href="/dashboard" class="btn btn-secondary">
                Back
            </a>
        </form>

    </div>

</body>