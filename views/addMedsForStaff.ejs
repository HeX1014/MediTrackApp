<!DOCTYPE html>
<html>

<head>
    <title>Add Medication (Staff)</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <div class="container mt-5">

        <h2>Add Medication</h2>

        <hr>

        <form action="/addMedsForStaff" method="POST">
            <div class="mb-3">

                <label class="form-label">
                    Medication Name *
                </label>
                <input type="text" name="medicationName" class="form-control" placeholder="Enter medication name"
                    required>
            </div>

            <div class="mb-3">

                <label class="form-label">
                    Expiry Date 
                </label>
                <input type="date" name="expDate" class="form-control">
            </div>

            <div class="mb-3">

                <label class="form-label">
                    Medication Type *
                </label>
                <input type="text" name="medicationType" class="form-control"
                    placeholder="Enter medication type (e.g., Prescription, Over-the-counter)" required>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Staff Notes 
                </label>
                <textarea name="notesForStaff" class="form-control" placeholder="Enter any notes for staff"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                Add Medication
            </button>

            <a href="/dashboard" class="btn btn-secondary">
                Back
            </a>
        </form>

    </div>

</body>