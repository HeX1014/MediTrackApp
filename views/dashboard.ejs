<!DOCTYPE html>
<html>

<head>
    <title>Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <div class="container mt-5">

        <h1>Dashboard</h1>

        <% if (messages && messages.length> 0) { %>

            <div class="alert alert-success">

                <% messages.forEach(function(message) { %>

                    <p class="mb-0">
                        <%= message %>
                    </p>

                    <% }); %>

            </div>

            <% } %>

                <% if (errors && errors.length> 0) { %>

                    <div class="alert alert-danger">

                        <% errors.forEach(function(error) { %>

                            <p class="mb-0">
                                <%= error %>
                            </p>

                            <% }); %>

                    </div>

                    <% } %>

                        <p>
                            Welcome,
                            <strong>
                                <%= user.username %>
                            </strong>
                            (<%= user.role %>)
                        </p>

                        <hr>

                        <!-- Patient dashboard -->
                        <% if ( user.role==='Patient' || user.role==='patient' ) { %>

                            <h4>Patient Services</h4>

                            <p>
                                Manage your appointments and personal medication tracker.
                            </p>

                            <a href="/addAppointment" class="btn btn-primary">
                                Book Appointment
                            </a>
                            <a href="/appointments" class="btn btn-outline-primary">
                                View Appointments
                            </a>
                            <a href="/addMedication" class="btn btn-success">
                                Add Medication
                            </a>
                            <a href="/medications" class="btn btn-outline-success">
                                View My Medications
                            </a>
                            <a href="/myschedule" class="btn btn-outline-dark">
                                My Schedule
                            </a>

                            <!-- Pharmacy staff dashboard -->
                             <% if (hasPendingDeletionRequest) { %>
                                <span class="btn btn-secondary disabled">
                                    Account Deletion Pending Review
                                </span>
                                <% } else { %>
                                    <form
                                    action="/account/delete-request"
                                    method="POST"
                                    class="d-inline"
                                    onsubmit="return confirm('Are you sure you want to request deletion of your account? An admin will need to approve this before your account is removed.');"
                                    >
                                    <button type="submit" class="btn btn-outline-danger">
                                        Delete My Account
                                    </button>
                                </form>
                                <% } %>
                                <% } else if ( user.role==='Pharmacy Staff' || user.role==='Staff' || user.role==='staff' )
                                { %>

                                <h4>Pharmacy Staff Services</h4>

                                <p>
                                    Add and manage medications in the pharmacy medication list.
                                </p>

                                <a href="/addMedsForStaff" class="btn btn-success">
                                    Add Medication
                                </a>
                                <a href="/staffMedications" class="btn btn-outline-success">
                                    View Medication List
                                </a>
                                
                                <% } %>

                                    <a href="/logout" class="btn btn-danger">
                                        Logout
                                    </a>

    </div>

</body>

</html>