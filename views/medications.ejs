<!DOCTYPE html>
<html>

<head>
    <title>Medication List</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

<div class="container mt-5">

    <% if (
        user.role === 'Patient' ||
        user.role === 'patient'
    ) { %>

        <h1>My Medication Tracker</h1>

        <p>
            View and search your personal medications.
        </p>

    <% } else { %>

        <h1>Pharmacy Medication List</h1>

        <p>
            View and search medications in the pharmacy list.
        </p>

    <% } %>

    <hr>

    <% if (messages && messages.length > 0) { %>

        <div class="alert alert-success">

            <% messages.forEach(function(message) { %>

                <p class="mb-0">
                    <%= message %>
                </p>

            <% }); %>

        </div>

    <% } %>

    <% if (errors && errors.length > 0) { %>

        <div class="alert alert-danger">

            <% errors.forEach(function(error) { %>

                <p class="mb-0">
                    <%= error %>
                </p>

            <% }); %>

        </div>

    <% } %>


    <!-- Search, filter and organise form -->

    <form
        action="/medications"
        method="GET"
        class="row g-2 mb-4"
    >

        <div class="col-md-4">

            <label class="form-label">
                Search Medication
            </label>

            <input
                type="text"
                name="search"
                class="form-control"
                value="<%= search %>"
                placeholder="Enter medication name"
            >

        </div>


        <div class="col-md-3">

            <label class="form-label">
                Filter by Frequency
            </label>

            <input
                type="text"
                name="frequency"
                class="form-control"
                value="<%= frequency %>"
                placeholder="Example: Once daily"
            >

        </div>


        <div class="col-md-3">

            <label class="form-label">
                Organise By
            </label>

            <select
                name="sort"
                class="form-select"
            >

                <option
                    value="name"
                    <% if (sort === 'name') { %>
                        selected
                    <% } %>
                >
                    Medication Name
                </option>

                <option
                    value="date"
                    <% if (sort === 'date') { %>
                        selected
                    <% } %>
                >
                    Newest Start Date
                </option>

            </select>

        </div>


        <div class="col-md-2 d-flex align-items-end">

            <button
                type="submit"
                class="btn btn-primary me-2"
            >
                Search
            </button>

            <a
                href="/medications"
                class="btn btn-secondary"
            >
                Reset
            </a>

        </div>

    </form>


    <% if (medications.length === 0) { %>

        <div class="alert alert-info">
            No medications found.
        </div>

    <% } else { %>

        <table class="table table-bordered table-hover">

            <thead class="table-light">

                <tr>
                    <th>Medication</th>
                    <th>Dosage</th>
                    <th>Frequency</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Notes</th>
                </tr>

            </thead>

            <tbody>

                <% for (
                    let i = 0;
                    i < medications.length;
                    i++
                ) { %>

                    <tr>

                        <td>
                            <%= medications[i].medicationName %>
                        </td>

                        <td>
                            <%= medications[i].dosage %>
                        </td>

                        <td>
                            <%= medications[i].frequency %>
                        </td>

                        <td>
                            <%= medications[i].startDate %>
                        </td>

                        <td>

                            <% if (medications[i].endDate) { %>

                                <%= medications[i].endDate %>

                            <% } else { %>

                                Ongoing

                            <% } %>

                        </td>

                        <td>
                            <%= medications[i].notes %>
                        </td>

                    </tr>

                <% } %>

            </tbody>

        </table>

    <% } %>


    <a
        href="/addMedication"
        class="btn btn-success"
    >
        Add Medication
    </a>

    <a
        href="/dashboard"
        class="btn btn-secondary"
    >
        Back to Dashboard
    </a>

</div>

</body>

</html>