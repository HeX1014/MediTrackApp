<!DOCTYPE html>
<html>

<head>
    <title>Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <div class="container mt-5">

        <h1>Admin Dashboard</h1>

        <p>
            Welcome,
            <strong>
                <%= user.username %>
            </strong>
            (<%= user.role %>)
        </p>

        <% if (messages && messages.length> 0) { %>

            <div class="alert alert-success">

                <% messages.forEach(function(message) { %>

                    <p class="mb-0">
                        <%= message %>
                    </p>

                    <% }); %>

            </div>

            <% } %>

                <% if (errors && errors.length> 0) { %>

                    <div class="alert alert-danger">

                        <% errors.forEach(function(error) { %>

                            <p class="mb-0">
                                <%= error %>
                            </p>

                            <% }); %>

                    </div>

                    <% } %>

                        <hr>

                        <h4>Administration</h4>

                        <p>
                            Manage pharmacy staff accounts and patient account-deletion requests.
                        </p>

                        <a href="/addStaff" class="btn btn-primary">
                            Add Pharmacy Staff
                        </a>

                        <a href="/logout" class="btn btn-danger">
                            Logout
                        </a>

                        <hr>
                        <h4>Manage Users</h4>
                        
                        <p>Remove patient or pharmacy staff accounts from the system.</p>
                        
                        <% if (users.length === 0) { %>
                            <div class="alert alert-info">No users found.</div>
                        <% } else { %>
                            <table class="table table-bordered table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Username</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% for (let i = 0; i < users.length; i++) { %>
                                        <tr>
                                            <td><%= users[i].username %></td>
                                            <td><%= users[i].email %></td>
                                            <td><%= users[i].role %></td>
                                            <td>
                                                <% if (users[i].id === user.id) { %>
                                                    <span class="text-muted">(You)</span>
                                                    <% } else { %>
                                                        <form
                                                        action="/admin/users/<%= users[i].id %>/delete"
                                                        method="POST"
                                                        class="d-inline"
                                                        onsubmit="return confirm('Are you sure you want to permanently delete this user account? This cannot be undone.');"
                                                        >
                                                        <button type="submit" class="btn btn-danger">Delete</button>
                                                    </form>
                                                    <% } %>
                                                </td>
                                            </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                    <% } %>

    </div>

</body>

</html>