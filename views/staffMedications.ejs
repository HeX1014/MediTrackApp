<!DOCTYPE html>
<html>

<head>
    <title>Staff Medication List</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

<div class="container mt-5">

    <% if (
        user.role === 'Staff' ||
        user.role === 'staff'
    ) { %>

        <h1>Staff Medication List</h1>

        <p>
            View and search medications in the pharmacy list.   
        </p>
    
    <% } %>

    <% if (messages && messages.length > 0) { %>

        <div class="alert alert-success">

            <% messages.forEach(function(message) { %>

                <p class="mb-0">
                    <%= message %>
                </p>

            <% }); %>

        </div>

    <% } %>

    <% if (errors && errors.length > 0) { %>

        <div class="alert alert-danger">

            <% errors.forEach(function(error) { %>

                <p class="mb-0">
                    <%= error %>
                </p>

            <% }); %>

        </div>

    <% } %>


    <form
        action="/staffMedications"
        method="GET"
        class="row g-2 mb-4"
    >

        <div class="col-md-4">

            <label class="form-label">
                Search Medication
            </label>

            <input
                type="text"
                name="search"
                class="form-control"
                value="<%= search %>"
                placeholder="Enter medication name"
            >

        </div>

        <div class="col-md-3">

            <label class="form-label">
                Organise By
            </label>

            <select
                name="sort"
                class="form-select"
            >

                <option
                    value="name"
                    <% if (sort === 'name') { %>
                        selected
                    <% } %>
                >
                    Medication Name
                </option>

                <option
                    value="date"
                    <% if (sort === 'date') { %>
                        selected
                    <% } %>
                >
                    Expiry Date
                </option>

            </select>

        </div>


        <div class="col-md-2 d-flex align-items-end">

            <button
                type="submit"
                class="btn btn-primary me-2"
            >
                Search
            </button>

            <a
                href="/staffMedications"
                class="btn btn-secondary"
            >
                Reset
            </a>

        </div>

    </form>


    <% if (medications.length === 0) { %>

        <div class="alert alert-info">
            No medications found.
        </div>

    <% } else { %>

        <table class="table table-bordered table-hover">

            <thead class="table-light">

                <tr>
                    <th>Medication</th>
                    <th>Expiry Date</th>
                    <th>Notes</th>
                    <th>Actions</th> </tr>

            </thead>

            <tbody>

                <% for (
                    let i = 0;
                    i < medications.length;
                    i++
                ) { %>

                    <tr>

                        <td>
                            <%= medications[i].medicationName %>
                        </td>

                        <td>
                            <%= medications[i].expDate %>
                        </td>

                        <td>
                            <%= medications[i].notesForStaff %>
                        </td>

                        <td>
                                <a href="/staff/editMedication/<%= medications[i].medicationId %>" class="btn btn-warning">
                                    Staff Edit Medication
                                </a>
                        </td>

                    </tr>

                <% } %>

            </tbody>

        </table>

    <% } %>


    <a
        href="/addMedsForStaff"
        class="btn btn-success"
    >
        Add Medication
    </a>
    
    <a
        href="/dashboard"
        class="btn btn-secondary"
    >
        Back to Dashboard
    </a>

</div>

</body>

</html>